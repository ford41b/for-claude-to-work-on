# ── Public (sent to the browser) ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Supabase "publishable" key (or legacy anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server only ──────────────────────────────────────────────────────────────
# Supabase "secret" key (or legacy service_role key). Never expose to the browser.
SUPABASE_SECRET_KEY=
# Direct Postgres connection for the worker and privileged writes.
# Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted: use the Supavisor pooler URL (transaction mode, port 6543).
DATABASE_URL=
DATABASE_POOL_MAX=5

# AI provider: gemini | none  (defaults to gemini when GEMINI_API_KEY is set, else none).
# "fixture" is a synthetic provider for automated tests and also needs ALLOW_FIXTURE_AI=true;
# never set it in production.
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL_MEDIA=gemini-3.8-flash
GEMINI_MODEL_SYNTHESIS=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional: official YouTube Data API v3 key (privacy/live status, duration). Without it the
# app uses oEmbed for title/channel only.
YOUTUBE_API_KEY=
# auto | off — "off" skips all YouTube metadata lookups (tests, offline development).
YOUTUBE_METADATA=auto

# Bible text provider: none | api_bible. Reserved — the API.Bible adapter is not built yet, so
# references are shown without verse text either way (see docs/API_LIMITATIONS.md).
BIBLE_PROVIDER=none
API_BIBLE_KEY=
API_BIBLE_BIBLE_ID=
API_BIBLE_TRANSLATION_LABEL=

# Protects /api/internal/jobs/run (serverless worker drain). Required in production.
CRON_SECRET=
WORKER_CONCURRENCY=3
# Optional: port for the worker's JSON health endpoint (container probes, test harness).
WORKER_HEALTH_PORT=
# auto | on | off — may request-scoped and cron drains run long media analysis? "auto" = yes,
# except on Vercel (functions are stopped at their time limit; run `npm run worker` elsewhere).
WEB_DRAIN_MEDIA=auto
# Set to "off" to stop web requests from draining the queue after they enqueue work.
INLINE_WORKER=
LOG_LEVEL=info
